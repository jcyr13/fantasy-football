# Copy to .env and fill in for a VPS deployment:  cp .env.example .env
# .env is gitignored. `docker compose` reads it automatically for the ${VAR}
# substitutions in docker-compose.yml. See deploy/README.md and docs/adr/0015.
#
# For local development none of this is needed — the defaults bind both services
# to 127.0.0.1 and leave the email alert logging to ERROR.

# --- Access binding --------------------------------------------------------
# Host address the published ports bind to. Default 127.0.0.1 = loopback only:
# safe, but unreachable from your phone. On the VPS set WEB_BIND to the host's
# Tailscale IP so the dashboard is reachable over the tailnet and nowhere else:
#   tailscale ip -4
# Leave API_BIND on loopback — only `web` talks to the API, over the compose
# network.
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1

# --- Timezone ------------------------------------------------------------------
# Container clock. The APScheduler crons pin America/New_York explicitly
# regardless, but keeping this aligned with the VPS timezone avoids confusion in
# logs and in the rsidecar systemd timer.
TZ=America/New_York

# --- nflverse pull failure alert (user story #42) ----------------------------
# Until DEADPARROTS_SMTP_HOST is set, a failed weekly nflverse pull is logged at
# ERROR, not emailed. For Gmail use an App Password (Account -> Security -> App
# passwords), not your normal password.
DEADPARROTS_SMTP_HOST=
DEADPARROTS_SMTP_PORT=587
DEADPARROTS_SMTP_USERNAME=
DEADPARROTS_SMTP_PASSWORD=
DEADPARROTS_SMTP_STARTTLS=true
DEADPARROTS_ALERT_EMAIL_TO=johncyrboston@gmail.com
DEADPARROTS_ALERT_EMAIL_FROM=deadparrots-dashboard@localhost

# --- Cloudflare Tunnel fallback ---------------------------------------------
# Only used with `docker compose --profile cloudflare up -d`. Token from the
# Zero Trust dashboard: Networks -> Tunnels -> (your tunnel) -> Install
# connector. Gate the public hostname with a Cloudflare Access policy (email
# OTP to DEADPARROTS_ALERT_EMAIL_TO) so it stays John-only.
TUNNEL_TOKEN=
